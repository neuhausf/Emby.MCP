#------------
# Copy this file to ".env" and replace the values with your own Emby server details.
# The ".env" file is intentionally excluded from version control (see .gitignore).

# Emby server URL.
# When running Emby in a separate Docker container on the same host, use:
#   EMBY_SERVER_URL=http://host.docker.internal:8096
# For a remote or LAN server use the actual IP/hostname:
#   EMBY_SERVER_URL=http://192.168.1.10:8096
EMBY_SERVER_URL=http://localhost:8096

EMBY_USERNAME=your-emby-username
EMBY_PASSWORD=your-emby-password

# Set to False to skip SSL certificate verification (e.g. self-signed certs).
EMBY_VERIFY_SSL=True

# Maximum number of items returned per chunk by search tools (0 = no limit).
# Items with rich metadata can average ~1 800 bytes each in JSON UTF-8 format.
# Tune this to stay within your LLM's per-call context limit.
LLM_MAX_ITEMS=100
#------------
